#!/usr/bin/env python3
"""vcut — entry point (ไม่ต้องติดตั้งอะไร ใช้ stdlib ล้วน + ffmpeg)"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

if sys.version_info < (3, 11):
    sys.exit("vcut ต้องใช้ Python 3.11 ขึ้นไป (ใช้ tomllib จาก stdlib)")

from vcut_engine.cli import main  # noqa: E402

if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print("\nยกเลิกแล้ว (cache ที่ทำไปแล้วยังอยู่ รันซ้ำจะทำต่อจากเดิม)")
        sys.exit(130)
