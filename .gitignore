# cache ทั้งหมด สร้างใหม่ได้จากฟุตเทจ + config
# ใช้ .vcut/* ไม่ใช่ .vcut/ เพราะ git จะไม่มองเข้าไปในไดเรกทอรีที่ถูก ignore ทั้งก้อน
# ทำให้บรรทัด ! ข้างล่างไม่มีผล
.vcut/*

# ยกเว้น EDL — ตัวนี้ควร commit เพราะเป็นตัวที่ทำให้ reproduce ผลลัพธ์ได้
!.vcut/edl.json

# ยกเว้นความเห็นของ AI — commit ไว้แล้วคนอื่นรัน decide ได้ผลเดียวกัน
# โดยไม่ต้องเรียก AI ใหม่ (และไม่ต้องมี API key)
!.vcut/ai.json

# ค่าเก่าที่เก็บไว้ก่อนกดรีเซ็ต — เป็นของเครื่องนี้เครื่องเดียว ไม่ใช่ผลงานของ
# โปรเจกต์ ถ้า commit ตามไปด้วย คนอื่น pull มาแล้วจะได้ "ประวัติการกดปุ่ม" ของเรา
# ติดไปเต็มไปหมด และเวลา merge จะชนกันทุกครั้งโดยไม่มีประโยชน์อะไรเลย
.vcut-history/

# ไฟล์ผลลัพธ์
*.mp4
*.mov
*.MOV

__pycache__/
*.pyc
.DS_Store

# ฟอนต์ที่ scripts/fetch_fonts.py ดึงมา — สร้างซ้ำได้จากสคริปต์ ไม่ต้องอยู่ในประวัติ
fonts/

# ไบนารีที่ตัวห่อ bundle มา — ดึงใหม่ได้จาก scripts/fetch_vendor.py
# (python-build-standalone · ffmpeg ที่มี libass · whisper-cli · แคชไฟล์ที่โหลดมา)
vendor/
bin/

# ผลของ `next build` — สร้างใหม่ได้ทุกเมื่อ serve.py เสิร์ฟจากที่นี่
vcut-ui/out/
vcut-ui/.next/

# ตัวห่อ Electron
desktop/node_modules/
desktop/dist/
desktop/resources/
